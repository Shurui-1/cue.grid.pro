# ==============================================================================
# CueGrid Pro - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' if you wish to override default server configurations.
# NOTE: CueGrid Pro runs 100% locally and does NOT require any external API keys.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8765

# Log Level (options: debug, info, warning, error)
LOG_LEVEL=info

# Optional External Integrations (leave empty for default local offline mode)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# BEATPORT_API_KEY=
